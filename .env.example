# Set a strong value (12+ characters) before the first production login.
ADMIN_PASSWORD=

# Optional extra key for signing admin sessions. Use a long random value.
ADMIN_SESSION_SECRET=

# Local/custom hosting only. Railway uses RAILWAY_VOLUME_MOUNT_PATH automatically.
# DATA_DIR=/absolute/path/to/persistent-volume

# LINE Official Account Messaging API (server only — never prefix with NEXT_PUBLIC_)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_OFFICIAL_ACCOUNT_ID=@299pgvbo
SITE_URL=https://lablae-website-production.up.railway.app

# Meta measurement is opt-in and disabled until Events Manager testing is complete.
META_MEASUREMENT_ENABLED=0
META_PIXEL_ID=2173890399880386
META_CAPI_ENABLED=0
# Server-only secret. Never commit real tokens.
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
META_TEST_EVENT_CODE=
